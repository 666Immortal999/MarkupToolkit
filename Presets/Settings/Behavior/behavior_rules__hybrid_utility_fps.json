  "derived_signals": {
    "hp_ratio": "hp / 100",
    "low_ammo": "ammo_clip < 5",
    "can_shoot": "ammo_clip > 0",
    "team_advantage": "alive_team / max(1, alive_enemy)",
    "enemy_near": "visible_enemies > 0 OR recent_sound_event",
    "danger": "(visible_enemies*0.5) + (1-hp_ratio) + (enemy_near ? 0.5 : 0)",
    "can_defuse": "bomb_time_left > defuse_time",
    "urgent": "bomb_time_left < 10"
  },
  "contexts": [
    "DEFAULT",
    "COMBAT",
    "RETAKE",
    "POST_PLANT",
    "SAVE"
  ],
  "context_resolver": [
    "if bomb_planted AND team == CT => RETAKE",
    "if bomb_planted AND team == T => POST_PLANT",
    "if alive_team <= 1 AND alive_enemy >= 3 => SAVE",
    "if visible_enemies > 0 OR enemy_near => COMBAT",
    "else => DEFAULT"
  ],
  "utility_formulas": {
    "SHOOT": "can_shoot * (visible_enemies > 0) * (1 - danger*0.5) * hp_ratio",
    "RELOAD": "low_ammo * (visible_enemies == 0) * (danger < 0.5)",
    "DEFUSE": "can_defuse ? (1-danger)*team_advantage : 0",
    "THROW_GRENADE": "(visible_enemies > 0) * has_grenade * (context in [RETAKE, COMBAT])",
    "TRADE": "teammate_recent_death * (distance_to_enemy < threshold)",
    "MOVE": "(visible_enemies == 0) + (danger > 0.7)",
    "SAVE": "(alive_team<=1) * (alive_enemy>=2) * weapon_value_high"
  },
  "context_modifiers": {
    "RETAKE": {
      "disable": [
        "PLANT"
      ],
      "boost": {
        "DEFUSE": 1.5,
        "THROW_GRENADE": 1.3
      }
    },
    "POST_PLANT": {
      "boost": {
        "MOVE": 1.2
      },
      "reduce": {
        "SHOOT": 0.85
      }
    },
    "SAVE": {
      "disable": [
        "DEFUSE",
        "TRADE",
        "THROW_GRENADE"
      ],
      "boost": {
        "MOVE": 2.0
      }
    },
    "COMBAT": {
      "boost": {
        "SHOOT": 1.5
      }
    }
  },
  "execution_pipeline": [
    "UpdatePerception",
    "ComputeDerivedData",
    "ResolveContext",
    "BuildAvailableActions(context)",
    "EvaluateUtility(actions)",
    "ApplyContextModifiers",
    "SelectBestAction(argmax)",
    "ExecuteAction"
  ],
  "constraints": {
    "scores_clamped_0_1": true,
    "impossible_actions_return_zero": true,
    "context_defines_allowed": true,
    "utility_defines_best": true
  },
  "notes": "Hybrid Behavior Tree + Utility AI preset generated from design prompt for tactical FPS bot."
}